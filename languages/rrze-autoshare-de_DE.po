msgstr ""

#. Description of the plugin
#: rrze-autoshare.php
msgid ""
"Automatically shares published WordPress content on Bluesky and Mastodon."
msgstr ""
"Veröffentlicht publizierte WordPress-Inhalte automatisch auf Bluesky und "
"Mastodon."

#. Author of the plugin
#: rrze-autoshare.php
msgid "RRZE-Webteam <webmaster@fau.de>"
msgstr ""

