#. Plugin Name of the plugin
#: rrze-autoshare.php
msgid "RRZE Autoshare"
msgstr "RRZE Autoshare"

#. Plugin URI of the plugin
#: rrze-autoshare.php
msgid "https://github.com/RRZE-Webteam/rrze-autoshare"
msgstr ""

#. Description of the plugin
#: rrze-autoshare.php
msgid ""
"Automatically shares published WordPress content on Bluesky and Mastodon."
msgstr "Veröffentlicht publizierte WordPress-Inhalte automatisch auf Bluesky und Mastodon."

#. Author of the plugin
#: rrze-autoshare.php
msgid "RRZE-Webteam <webmaster@fau.de>"
msgstr ""

#. Author URI of the plugin
#: rrze-autoshare.php
msgid "https://www.wp.rrze.fau.de"
msgstr ""

#: includes/Main.php:42
msgid "Settings"
msgstr "Einstellungen"

#: includes/Main.php:111 includes/Metabox.php:25
msgid "Autoshare"
msgstr "Autoshare"

#: includes/Main.php:112 includes/Metabox.php:60
msgid "Share on Bluesky"
msgstr "Auf Bluesky teilen"

#: includes/Main.php:113 includes/Metabox.php:60
msgid "Share on Bluesky is disabled"
msgstr "Teilen auf Bluesky ist deaktiviert"

#: includes/Main.php:114 includes/Metabox.php:61
msgid "It is published on Bluesky"
msgstr "Es ist auf Bluesky veröffentlicht"

#: includes/Main.php:115 includes/Metabox.php:83
msgid "Share on Mastodon"
msgstr "Auf Mastodon teilen"

#: includes/Main.php:116 includes/Metabox.php:83
msgid "Share on Mastodon is disabled"
msgstr "Teilen auf Mastodon ist deaktiviert"

#: includes/Main.php:117 includes/Metabox.php:84
msgid "It is published on Mastodon"
msgstr "Es ist auf Mastodon veröffentlicht"

#: includes/Services/Bluesky/API.php:335 includes/Services/Mastodon/API.php:347
msgid "An error occurred while trying to publish."
msgstr "Beim Versuch der Veröffentlichung ist ein Fehler aufgetreten."

#. translators: %d is the error code.
#: includes/Services/Bluesky/API.php:354 includes/Services/Mastodon/API.php:366
msgid "Error: %d. "
msgstr "Fehler: %d. "

#: includes/Services/Bluesky/API.php:364
msgid "This post was not published on Bluesky."
msgstr "Dieser Beitrag wurde nicht auf Bluesky veröffentlicht."

#: includes/Services/Mastodon/API.php:376
msgid "This post was not published on Mastodon."
msgstr "Dieser Beitrag wurde nicht auf Mastodon veröffentlicht."

#: includes/Services/Mastodon/API.php:403 includes/Settings.php:541
msgid "Revoke Access"
msgstr "Zugriff widerrufen"

#: includes/Services/Mastodon/API.php:404 includes/Settings.php:575
msgid "Authorize Access"
msgstr "Zugriff autorisieren"

#: includes/Services/Mastodon/API.php:409
msgid "You’ve authorized Autoshare to read and write to the Mastodon timeline."
msgstr ""
"Sie haben Autoshare autorisiert, die Mastodon-Timeline zu lesen und zu "
"schreiben."

#: includes/Services/Mastodon/API.php:410
msgid "Authorize Autoshare to read and write to the Mastodon timeline."
msgstr ""
"Autorisieren Sie Autoshare zum Lesen und Schreiben in die Mastodon-Timeline."

#: includes/Settings.php:34 includes/Settings.php:230
msgid "Autoshare Settings"
msgstr "Einstellungen › Autoshare"

#: includes/Settings.php:35
msgid "RRZE-Autoshare"
msgstr "RRZE-Autoshare"

#: includes/Settings.php:117
msgid "The format cannot be empty."
msgstr "Das Format darf nicht leer sein."

#: includes/Settings.php:264
msgid "Disabled because no authorization is available."
msgstr "Deaktiviert, da keine Autorisierung vorliegt."

#: includes/Settings.php:356
msgid "Active Services"
msgstr "Aktive Dienste"

#: includes/Settings.php:359
msgid "Services"
msgstr "Dienste"

#: includes/Settings.php:367
msgid "Select the services that Autoshare should use when publishing content."
msgstr ""
"Wählen Sie die Dienste aus, die Autoshare beim Veröffentlichen von Inhalten "
"verwenden soll."

#: includes/Settings.php:377
msgid "Bluesky Settings"
msgstr "Bluesky Einstellungen"

#: includes/Settings.php:380 includes/Settings.php:403
msgid "Service URL"
msgstr "Dienst-URL"

#: includes/Settings.php:386
msgid "The URL of the Bluesky service."
msgstr "Die URL des Bluesky-Dienstes."

#: includes/Settings.php:400
msgid "Mastodon Settings"
msgstr "Mastodon Einstellungen"

#: includes/Settings.php:409
msgid "The URL of the Mastodon service."
msgstr "Die URL des Mastodon-Dienstes."

#: includes/Settings.php:414
msgid "Username"
msgstr "Benutzername"

#: includes/Settings.php:420
msgid "The Mastodon account username."
msgstr "Der Benutzername des Mastodon-Kontos."

#: includes/Settings.php:433
msgid "Content Types"
msgstr "Inhaltstypen"

#: includes/Settings.php:440
msgid "Select the type of content that Autoshare could use."
msgstr "Wählen Sie die Art von Inhalten aus, die Autoshare verwenden könnte."

#: includes/Settings.php:450
msgid "Featured Images"
msgstr "Beitragsbild"

#: includes/Settings.php:456
msgid "Include featured images"
msgstr "Beitragsbild hinzufügen"

#. translators: 1: Accepted content type, 2: Maximum number of characters.
#: includes/Settings.php:466
msgid "Accepted content type: %1$s. Maximum post length: %2$d characters."
msgstr "Akzeptierter Inhaltstyp: %1$s. Maximale Beitragslänge: %2$d Zeichen."

#: includes/Settings.php:467
msgid "Text"
msgstr "Text"

#: includes/Settings.php:471
msgid "The actual limit can differ depending on the Mastodon instance."
msgstr "Die tatsächliche Begrenzung kann je nach Mastodon-Instanz abweichen."

#: includes/Settings.php:476
msgid "Post Format"
msgstr "Beitragsformat"

#: includes/Settings.php:485
msgid "Format"
msgstr "Format"

#: includes/Settings.php:491
msgid ""
"Use the placeholders {title}, {excerpt}, {url}, and {tags}. Empty lines are "
"removed automatically."
msgstr ""
"Verwenden Sie die Platzhalter {title}, {excerpt}, {url} und {tags}. Leere "
"Zeilen werden automatisch entfernt."

#: includes/Settings.php:509
msgid ""
"Bluesky, also known as Bluesky Social, is a social microblogging platform."
"<br>Please complete the settings fields so that Autoshare can read and write "
"to the Bluesky timeline."
msgstr ""
"Bluesky, auch bekannt als Bluesky Social, ist eine soziale Microblogging-"
"Plattform.<br>Bitte füllen Sie die Einstellungsfelder aus, damit Autoshare "
"die Bluesky-Timeline lesen und schreiben kann."

#: includes/Settings.php:513
msgid ""
"Mastodon is a free social networking service with microblogging features."
"<br>Please complete the settings fields so that Autoshare can read and write "
"to the Mastodon timeline."
msgstr ""
"Mastodon ist ein freier sozialer Netzwerkdienst mit Microblogging-Funktionen."
"<br>Bitte fuellen Sie die Einstellungsfelder aus, damit Autoshare die "
"Mastodon-Timeline lesen und bearbeiten kann."

#: includes/Settings.php:534 includes/Settings.php:584
msgid "Access"
msgstr "Zugriff"

#: includes/Settings.php:537
msgid "You’ve authorized Autoshare to read and write to the Bluesky timeline."
msgstr ""
"Sie haben Autoshare autorisiert, die Bluesky-Timeline zu lesen und zu "
"schreiben."

#: includes/Settings.php:544
msgid "Authorize Autoshare to read and write to the Bluesky timeline."
msgstr ""
"Autorisieren Sie Autoshare zum Lesen und Schreiben in die Bluesky-Timeline."

#: includes/Settings.php:548
msgid "Username or email address"
msgstr "Benutzername oder E-Mail-Adresse"

#: includes/Settings.php:552
msgid "Bluesky App Password"
msgstr "Bluesky-App-Passwort"

#. translators: 1: Bluesky App Password settings URL, 2: Bluesky App Password information URL.
#: includes/Settings.php:560
msgid ""
"Create a separate <a href=\"%1$s\" target=\"_blank\" rel=\"noopener "
"noreferrer\">Bluesky App Password</a>. Do not enter the Bluesky account "
"password. <a href=\"%2$s\" target=\"_blank\" rel=\"noopener "
"noreferrer\">Learn more about App Passwords</a>. The entered data is used "
"only once for authorization and is not saved."
msgstr ""
"Erstellen Sie ein separates <a href=\"%1$s\" target=\"_blank\" "
"rel=\"noopener noreferrer\">Bluesky-App-Passwort</a>. Geben Sie nicht das "
"Passwort Ihres Bluesky-Kontos ein. <a href=\"%2$s\" target=\"_blank\" "
"rel=\"noopener noreferrer\">Mehr über App-Passwörter erfahren</a>. Die "
"eingegebenen Daten werden nur einmal für die Autorisierung verwendet und "
"nicht gespeichert."

#: includes/Settings.php:598
msgid "Bluesky access was authorized."
msgstr "Der Zugriff auf Bluesky wurde autorisiert."

#: includes/Settings.php:600
msgid ""
"Bluesky access could not be authorized. Check the account identifier and App "
"Password."
msgstr ""
"Der Zugriff auf Bluesky konnte nicht autorisiert werden. Prüfen Sie die "
"Konto-Kennung und das App-Passwort."

#: includes/Settings.php:602
msgid "Bluesky access was revoked."
msgstr "Der Zugriff auf Bluesky wurde widerrufen."

#: includes/Settings.php:608
msgid "You do not have enough permissions to do that."
msgstr "Dazu haben Sie nicht genügend Berechtigungen."

#: includes/Settings.php:613
msgid "The link you followed has expired. Please try again."
msgstr "Der aufgerufene Link ist abgelaufen. Bitte versuchen Sie es erneut."

#: includes/Settings.php:630
msgid "General"
msgstr "Allgemeines"

#: includes/Settings.php:631
msgid "Bluesky"
msgstr "Bluesky"

#: includes/Settings.php:632
msgid "Mastodon"
msgstr "Mastodon"

#. translators: 1: Server WordPress version number, 2: Required WordPress version number.
#: rrze-autoshare.php:156 rrze-autoshare.php:199
msgid ""
"The server is running WordPress version %1$s. The plugin requires at least "
"WordPress version %2$s."
msgstr ""
"Auf dem Server läuft WordPress Version %1$s. Das Plugin erfordert mindestens "
"WordPress Version %2$s."

#. translators: 1: Server PHP version number, 2: Required PHP version number.
#: rrze-autoshare.php:165 rrze-autoshare.php:206
msgid ""
"The server is running PHP version %1$s. The plugin requires at least PHP "
"version %2$s."
msgstr ""
"Auf dem Server läuft PHP Version %1$s. Das Plugin erfordert mindestens PHP "
"Version %2$s."

