{
  "name": "rrze-autoshare",
  "title": "RRZE Autoshare",
  "version": "2.0.3",
  "description": "Automatically shares published WordPress content on Bluesky and Mastodon.",
  "main": "rrze-autoshare.php",
  "textdomain": "rrze-autoshare",
  "private": true,
  "compatibility": {
    "wprequires": "6.7",
    "wptestedup": "7.1",
    "phprequires": "8.2"
  },
  "supports": {
    "email": "webmaster@fau.de"
  },
  "author": {
    "name": "RRZE-Webteam <webmaster@fau.de>",
    "url": "https://www.wp.rrze.fau.de"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RRZE-Webteam/rrze-autoshare",
    "issues": "https://github.com/RRZE-Webteam/rrze-autoshare/issues",
    "clone": "git+https://github.com/RRZE-Webteam/rrze-autoshare.git"
  },
  "license": "GNU General Public License v3",
  "licenseurl": "https://www.gnu.org/licenses/gpl-3.0.html",
  "tags": "Plugin, WordPress, Autoshare, Bluesky, Mastodon, Social Media, RRZE, FAU",
  "source": {
    "js": "./src/js/",
    "css": "./src/sass/"
  },
  "target": {
    "js": "./build/js/",
    "css": "./build/css/"
  },
  "engines": {
    "node": ">=21.5.0",
    "npm": ">=10.2.4"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "sass": "^1.94.2"
  },
  "scripts": {
    "start": "node scripts/build-assets.js dev --watch",
    "watch": "node scripts/build-assets.js dev --watch",
    "build": "node scripts/build-assets.js dev",
    "build:assets:dev": "node scripts/build-assets.js dev",
    "build:assets:prod": "node scripts/build-assets.js prod",
    "readme": "node scripts/build-readme.js",
    "version:dev": "node scripts/build-version.js dev",
    "version:prod": "node scripts/build-version.js prod",
    "version:release": "node scripts/build-version.js release",
    "dev": "npm run build && npm run version:dev && npm run readme",
    "prod": "npm run build:assets:prod && npm run version:prod && npm run readme",
    "release": "npm run build:assets:prod && npm run version:release && npm run readme"
  }
}
